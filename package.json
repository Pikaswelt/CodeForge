{
  "name": "codeforge-desktop",
  "private": true,
  "version": "2.10.0",
  "description": "Desktop UI for local coding agents across Antigravity CLI, Codex CLI and Claude Code",
  "author": "CodeForge <info@codeforge.app>",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "codeforge-cli": "./codeforge-cli.mjs"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --port=3000 --host=127.0.0.1\" \"wait-on tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "mobile:dev": "concurrently -k \"node scripts/mobile-dev-bridge.mjs\" \"vite --port=3001 --host=127.0.0.1\"",
    "mobile:bridge": "node scripts/mobile-dev-bridge.mjs",
    "apk:build": "node build-apk.mjs",
    "apk:release": "npm run build && npx cap sync android && node -e \"require('child_process').spawnSync(process.platform==='win32'?'gradlew.bat':'./gradlew',['assembleRelease'],{cwd:'android',stdio:'inherit',shell:true})\" && echo Release APK unter: android/app/build/outputs/apk/release/",
    "server:install": "node codeforge-remote-server.mjs",
    "cli": "node codeforge-cli.mjs",
    "cli:install": "npm install -g .",
    "release:all": "npm run dist:win && npm run apk:build && node -e \"require('fs').copyFileSync('codeforge-cli.mjs','release/codeforge-cli.mjs')\" && echo 'Builds fertig: release/*.exe, release/*.apk, und release/codeforge-cli.mjs'"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-pty": "^1.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.0.16",
    "wait-on": "^8.0.3"
  },
  "build": {
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@xterm/headless/**"
    ],
    "appId": "app.codeforge.desktop",
    "productName": "CodeForge",
    "artifactName": "CodeForge-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/codeforge.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/codeforge.png",
      "category": "Development",
      "artifactName": "CodeForge-${version}-${arch}.${ext}",
      "synopsis": "Desktop workspace for AI coding agents",
      "maintainer": "Pikaswelt <info@codeforge.app>"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/codeforge.ico",
      "uninstallerIcon": "assets/codeforge.ico",
      "installerHeaderIcon": "assets/codeforge.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "CodeForge",
      "menuCategory": "CodeForge",
      "include": "electron/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Pikaswelt",
        "repo": "CodeForge"
      }
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libgbm1",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  },
  "homepage": "https://github.com/Pikaswelt/CodeForge"
}
