{
  "name": "codeforge-desktop",
  "private": true,
    "version": "2.4.0",
  "description": "Desktop UI for local coding agents across Antigravity CLI, Codex CLI and Claude Code",
  "author": "CodeForge",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "codeforge-cli": "./codeforge-cli.mjs"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --port=3000 --host=127.0.0.1\" \"wait-on tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "apk:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug && echo 'APK erstellt unter: android/app/build/outputs/apk/debug/app-debug.apk'",
    "apk:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease && echo 'Release APK unter: android/app/build/outputs/apk/release/'",
    "server:install": "node codeforge-remote-server.mjs",
    "cli": "node codeforge-cli.mjs",
    "cli:install": "npm install -g .",
    "release:all": "npm run dist:win && npm run apk:build && node -e \"require('fs').copyFileSync('codeforge-cli.mjs','release/codeforge-cli.mjs')\" && echo 'Builds fertig: release/*.exe, android/app/build/outputs/apk/debug/, und release/codeforge-cli.mjs'"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-pty": "^1.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ws": "^8.21.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.0.16",
    "wait-on": "^8.0.3"
  },
  "build": {
    "npmRebuild": false,
    "appId": "app.codeforge.desktop",
    "productName": "CodeForge",
    "artifactName": "CodeForge-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/codeforge.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/codeforge.ico",
      "uninstallerIcon": "assets/codeforge.ico",
      "installerHeaderIcon": "assets/codeforge.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "CodeForge",
      "menuCategory": "CodeForge"
    }
  }
}
